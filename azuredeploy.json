{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "One-click demo: deploys a minimal native Azure Virtual Desktop environment (Personal host pool, workspace, desktop application group, one Microsoft Entra-joined single-session Windows 11 Enterprise session host, outbound internet via a NAT Gateway) and grants the person who deploys it access to log in immediately via the AVD web client. Demo/POC only \u2014 not hardened for production."
  },
  "parameters": {
    "namePrefix": {
      "type": "string",
      "defaultValue": "avddemo",
      "minLength": 3,
      "maxLength": 10,
      "metadata": {
        "description": "Short prefix used to name all resources (lowercase letters/numbers only, e.g. avddemo)."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region to deploy into. Defaults to the resource group's region."
      }
    },
    "pizzaSize": {
      "type": "string",
      "defaultValue": "\ud83c\udf55 Personal Pan (2 vCPU / 8 GB)",
      "allowedValues": [
        "\ud83c\udf55 Personal Pan (2 vCPU / 8 GB)",
        "\ud83c\udf55\ud83c\udf55 Family Size (4 vCPU / 16 GB)",
        "\ud83c\udf55\ud83c\udf55\ud83c\udf55 Large Party (8 vCPU / 32 GB)"
      ],
      "metadata": {
        "description": "Session host VM size. Personal Pan is plenty for a demo."
      }
    },
    "pizzaCrust": {
      "type": "string",
      "defaultValue": "\ud83e\uddc0 Stuffed Crust (Standard SSD disk \u2014 balanced, default)",
      "allowedValues": [
        "\ud83e\uddc0 Stuffed Crust (Standard SSD disk \u2014 balanced, default)",
        "\ud83c\udf5e Thin Crust (Standard HDD disk \u2014 cheapest, slower)",
        "\ud83c\udf55 Deep Dish (Premium SSD disk \u2014 fastest, priciest)"
      ],
      "metadata": {
        "description": "OS disk tier for the session host (Chicago-style naming: Deep Dish is the good one). Doesn't change deploy time \u2014 just cost and in-session disk performance."
      }
    },
    "pizzaToppings": {
      "type": "string",
      "defaultValue": "\ud83e\uddc0 Cheese (Windows 11 24H2 Enterprise)",
      "allowedValues": [
        "\ud83e\uddc0 Cheese (Windows 11 24H2 Enterprise)",
        "\ud83c\udf2d Sausage (Windows 11 25H2 Enterprise, newest)",
        "\ud83c\udf55 Pepperoni (Windows 11 23H2 Enterprise, older release)"
      ],
      "metadata": {
        "description": "Desktop OS image/version \u2014 single-session Windows 11 Enterprise (switched from multi-session AVD images 2026-08-20 to match the Personal host pool type). Note: unlike the prior multi-session images, there is no marketplace SKU with Microsoft 365 Apps preinstalled for single-session Enterprise under this publisher/offer (confirmed via Microsoft Learn) \u2014 toppings now represent OS version choice only. Install M365 Apps separately if needed; out of scope for MVP."
      }
    },
    "toppingPepperoni": {
      "type": "string",
      "defaultValue": "Yes, pepperoni (clipboard + drive redirection on)",
      "allowedValues": [
        "Yes, pepperoni (clipboard + drive redirection on)",
        "No thanks (locked down session)"
      ],
      "metadata": {
        "description": "Toggles a real RDP property: local clipboard and drive redirection into the session."
      }
    },
    "adminUsername": {
      "type": "string",
      "defaultValue": "avddemoadmin",
      "metadata": {
        "description": "Local administrator username for the session host (not used for AVD sign-in, which uses Microsoft Entra ID)."
      }
    },
    "adminPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Local administrator password for the session host. Must meet Azure complexity requirements (12+ chars, 3 of: upper/lower/number/symbol)."
      }
    },
    "utcValue": {
      "type": "string",
      "defaultValue": "[utcNow()]"
    },
    "selfDestructHours": {
      "type": "int",
      "defaultValue": 4,
      "minValue": 1,
      "maxValue": 12,
      "metadata": {
        "description": "Hours from deployment until this resource group is automatically torn down (default 4, max 12). Written as a resource-group tag (SelfDestructAtUtc) alongside a shared OrderNumber tag — the lab-manager teardown backend reads both to enforce the deadline and record destruction, independently verifiable against this template's own tags. This template does not delete anything itself; see FreshDesktopDemo ADR-2."
      }
    }
  },
  "variables": {
    "orderNumber": "[concat(parameters('namePrefix'), '-', dateTimeAdd(parameters('utcValue'), 'PT0H', 'yyyyMMddHHmmss'))]",
    "selfDestructAtUtc": "[dateTimeAdd(parameters('utcValue'), concat('PT', string(parameters('selfDestructHours')), 'H'))]",
    "labExpiryMode": "[concat('Hours', string(parameters('selfDestructHours')))]",
    "hostPoolName": "[concat(parameters('namePrefix'), '-hp')]",
    "appGroupName": "[concat(parameters('namePrefix'), '-dag')]",
    "workspaceName": "[concat(parameters('namePrefix'), '-ws')]",
    "nsgName": "[concat(parameters('namePrefix'), '-nsg')]",
    "logAnalyticsWorkspaceName": "[concat(parameters('namePrefix'), '-law')]",
    "vnetName": "[concat(parameters('namePrefix'), '-vnet')]",
    "subnetName": "default",
    "nicName": "[concat(parameters('namePrefix'), '-nic')]",
    "vmName": "[concat(parameters('namePrefix'), '-vm')]",
    "natGatewayName": "[concat(parameters('namePrefix'), '-natgw')]",
    "natPublicIPName": "[concat(parameters('namePrefix'), '-natgw-pip')]",
    "addressPrefix": "10.20.0.0/24",
    "subnetPrefix": "10.20.0.0/24",
    "registrationTokenExpiration": "[dateTimeAdd(parameters('utcValue'), 'PT4H')]",
    "desktopVirtualizationUserRoleId": "1d18fff3-a72a-46b5-b4a9-0b38a3cd7e63",
    "vmUserLoginRoleId": "fb879df8-f326-4884-b1cf-06f3ad86be52",
    "vmSizeMap": {
      "\ud83c\udf55 Personal Pan (2 vCPU / 8 GB)": "Standard_D2as_v5",
      "\ud83c\udf55\ud83c\udf55 Family Size (4 vCPU / 16 GB)": "Standard_D4as_v5",
      "\ud83c\udf55\ud83c\udf55\ud83c\udf55 Large Party (8 vCPU / 32 GB)": "Standard_D8as_v5"
    },
    "imageSkuMap": {
      "\ud83e\uddc0 Cheese (Windows 11 24H2 Enterprise)": "win11-24h2-ent",
      "\ud83c\udf2d Sausage (Windows 11 25H2 Enterprise, newest)": "win11-25h2-ent",
      "\ud83c\udf55 Pepperoni (Windows 11 23H2 Enterprise, older release)": "win11-23h2-ent"
    },
    "rdpPropertyMap": {
      "Yes, pepperoni (clipboard + drive redirection on)": "drivestoredirect:s:*;redirectclipboard:i:1;",
      "No thanks (locked down session)": ""
    },
    "diskTierMap": {
      "\ud83e\uddc0 Stuffed Crust (Standard SSD disk \u2014 balanced, default)": {
        "storageType": "StandardSSD_LRS",
        "sizeGB": 128
      },
      "\ud83c\udf5e Thin Crust (Standard HDD disk \u2014 cheapest, slower)": {
        "storageType": "Standard_LRS",
        "sizeGB": 128
      },
      "\ud83c\udf55 Deep Dish (Premium SSD disk \u2014 fastest, priciest)": {
        "storageType": "Premium_LRS",
        "sizeGB": 256
      }
    },
    "vmSize": "[variables('vmSizeMap')[parameters('pizzaSize')]]",
    "imageSku": "[variables('imageSkuMap')[parameters('pizzaToppings')]]",
    "customRdpProperty": "[concat(variables('rdpPropertyMap')[parameters('toppingPepperoni')], 'enablerdsaadauth:i:1;')]",
    "diskStorageType": "[variables('diskTierMap')[parameters('pizzaCrust')].storageType]",
    "diskSizeGB": "[variables('diskTierMap')[parameters('pizzaCrust')].sizeGB]"
  },
  "resources": [
    {
      "type": "Microsoft.Resources/tags",
      "apiVersion": "2023-07-01",
      "name": "default",
      "comments": "Sets resource-group-level tags: OrderNumber (shared correlation ID) + SelfDestructAtUtc (expiration deadline) are the tag contract handed off to the lab-manager teardown backend (see FreshDesktopDemo ADR-2) — this template does not enforce deletion itself, only publishes what the backend needs to read and, on its side, log destruction against the same OrderNumber for independent verification. LabExpiryDate/LabExpiryMode/LabKit are a second, double-tag contract added 2026-08-23 once lab-manager confirmed the exact keys/formats its own LabExpiry.psm1/Invoke-LabKillSwitch.ps1 read (see RAID DEP-2) — LabExpiryDate duplicates SelfDestructAtUtc verbatim (same instant, no second computation), LabExpiryMode is a label only today (their killswitch doesn't consult it — see RAID I-15 on lab-manager's side), and LabKit is their fixed literal for this lab, not a per-deploy value.",
      "properties": {
        "tags": {
          "Project": "fresh-desktop-avd-demo",
          "OrderNumber": "[variables('orderNumber')]",
          "DeployedAtUtc": "[parameters('utcValue')]",
          "SelfDestructAtUtc": "[variables('selfDestructAtUtc')]",
          "SelfDestructHours": "[string(parameters('selfDestructHours'))]",
          "DeployedBy": "[deployer().userPrincipalName]",
          "LabExpiryDate": "[variables('selfDestructAtUtc')]",
          "LabExpiryMode": "[variables('labExpiryMode')]",
          "LabKit": "LabManager"
        }
      }
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2022-10-01",
      "name": "[variables('logAnalyticsWorkspaceName')]",
      "location": "[parameters('location')]",
      "comments": "Added per data-governance review finding F3 (Medium) / RAID R-13 monitoring gap, 2026-08-24 — previously only the platform-default Activity Log applied (no diagnostic settings, Log Analytics workspace, or NSG flow logs). This workspace is the diagnostic-settings destination for the NSG and the AVD host pool/workspace below, so a real deployment now produces actual monitoring data instead of relying on the platform default alone. Torn down with the rest of the resource group on self-destruct (no separate retention need for an ephemeral demo).",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2023-09-01",
      "name": "[variables('natPublicIPName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "publicIPAllocationMethod": "Static"
      }
    },
    {
      "type": "Microsoft.Network/natGateways",
      "apiVersion": "2023-09-01",
      "name": "[variables('natGatewayName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/publicIPAddresses', variables('natPublicIPName'))]"
      ],
      "properties": {
        "publicIpAddresses": [
          {
            "id": "[resourceId('Microsoft.Network/publicIPAddresses', variables('natPublicIPName'))]"
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2023-09-01",
      "name": "[variables('nsgName')]",
      "location": "[parameters('location')]",
      "comments": "Explicit deny-inbound baseline (RAID Risk R-13, Full Architecture Review 2026-08-23). The session host has no public IP and isn't open to inbound internet traffic regardless (NAT Gateway is outbound-only, AVD reverse-connects outbound to the service), so this NSG's default rules already match that reality — it's added for an explicit, auditable security boundary on the subnet rather than relying solely on 'no public IP' as the only control. No custom rules needed: Azure's built-in NSG defaults (DenyAllInBound below any AllowVnetInBound/AllowAzureLoadBalancerInBound, AllowVnetOutBound/AllowInternetOutBound) already match this template's actual traffic pattern.",
      "properties": {
        "securityRules": [
          {
            "name": "DenyAllInboundFromInternet",
            "properties": {
              "priority": 200,
              "direction": "Inbound",
              "access": "Deny",
              "protocol": "*",
              "sourcePortRange": "*",
              "destinationPortRange": "*",
              "sourceAddressPrefix": "Internet",
              "destinationAddressPrefix": "*",
              "description": "Explicit, auditable deny of internet inbound traffic; redundant with NSG defaults (VM has no public IP regardless)."
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups/providers/diagnosticSettings",
      "apiVersion": "2021-05-01-preview",
      "name": "[concat(variables('nsgName'), '/Microsoft.Insights/nsg-diagnostics')]",
      "comments": "Added per data-governance review finding F3 (Medium), 2026-08-24 — routes NSG rule/event logs to the Log Analytics workspace above so inbound-deny activity on this subnet is actually observable, not just implied by the NSG's rule config.",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]",
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsWorkspaceName'))]"
      ],
      "properties": {
        "workspaceId": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsWorkspaceName'))]",
        "logs": [
          {
            "category": "NetworkSecurityGroupEvent",
            "enabled": true
          },
          {
            "category": "NetworkSecurityGroupRuleCounter",
            "enabled": true
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2023-09-01",
      "name": "[variables('vnetName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/natGateways', variables('natGatewayName'))]",
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]"
      ],
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "[variables('addressPrefix')]"
          ]
        },
        "subnets": [
          {
            "name": "[variables('subnetName')]",
            "properties": {
              "addressPrefix": "[variables('subnetPrefix')]",
              "natGateway": {
                "id": "[resourceId('Microsoft.Network/natGateways', variables('natGatewayName'))]"
              },
              "networkSecurityGroup": {
                "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]"
              }
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2023-09-01",
      "name": "[variables('nicName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
      ],
      "properties": {
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "subnet": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), variables('subnetName'))]"
              }
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.DesktopVirtualization/hostPools",
      "apiVersion": "2024-04-03",
      "name": "[variables('hostPoolName')]",
      "location": "[parameters('location')]",
      "properties": {
        "hostPoolType": "Personal",
        "personalDesktopAssignmentType": "Automatic",
        "loadBalancerType": "Persistent",
        "preferredAppGroupType": "Desktop",
        "customRdpProperty": "[variables('customRdpProperty')]",
        "startVMOnConnect": true,
        "validationEnvironment": false,
        "registrationInfo": {
          "expirationTime": "[variables('registrationTokenExpiration')]",
          "registrationTokenOperation": "Update"
        }
      }
    },
    {
      "type": "Microsoft.DesktopVirtualization/applicationGroups",
      "apiVersion": "2024-04-03",
      "name": "[variables('appGroupName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.DesktopVirtualization/hostPools', variables('hostPoolName'))]"
      ],
      "properties": {
        "applicationGroupType": "Desktop",
        "hostPoolArmPath": "[resourceId('Microsoft.DesktopVirtualization/hostPools', variables('hostPoolName'))]"
      }
    },
    {
      "type": "Microsoft.DesktopVirtualization/workspaces",
      "apiVersion": "2024-04-03",
      "name": "[variables('workspaceName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.DesktopVirtualization/applicationGroups', variables('appGroupName'))]"
      ],
      "properties": {
        "friendlyName": "AVD Demo Workspace",
        "applicationGroupReferences": [
          "[resourceId('Microsoft.DesktopVirtualization/applicationGroups', variables('appGroupName'))]"
        ]
      }
    },
    {
      "type": "Microsoft.DesktopVirtualization/hostPools/providers/diagnosticSettings",
      "apiVersion": "2021-05-01-preview",
      "name": "[concat(variables('hostPoolName'), '/Microsoft.Insights/hostpool-diagnostics')]",
      "comments": "Added per data-governance review finding F3 (Medium), 2026-08-24 — routes host pool connection/registration/agent-health logs to the Log Analytics workspace above, giving real sign-in/session diagnostics instead of relying on the platform-default Activity Log.",
      "dependsOn": [
        "[resourceId('Microsoft.DesktopVirtualization/hostPools', variables('hostPoolName'))]",
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsWorkspaceName'))]"
      ],
      "properties": {
        "workspaceId": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsWorkspaceName'))]",
        "logs": [
          { "category": "Checkpoint", "enabled": true },
          { "category": "Error", "enabled": true },
          { "category": "Management", "enabled": true },
          { "category": "Connection", "enabled": true },
          { "category": "HostRegistration", "enabled": true },
          { "category": "AgentHealthStatus", "enabled": true }
        ]
      }
    },
    {
      "type": "Microsoft.DesktopVirtualization/workspaces/providers/diagnosticSettings",
      "apiVersion": "2021-05-01-preview",
      "name": "[concat(variables('workspaceName'), '/Microsoft.Insights/workspace-diagnostics')]",
      "comments": "Added per data-governance review finding F3 (Medium), 2026-08-24 — routes AVD workspace feed/management logs to the same Log Analytics workspace.",
      "dependsOn": [
        "[resourceId('Microsoft.DesktopVirtualization/workspaces', variables('workspaceName'))]",
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsWorkspaceName'))]"
      ],
      "properties": {
        "workspaceId": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsWorkspaceName'))]",
        "logs": [
          { "category": "Checkpoint", "enabled": true },
          { "category": "Error", "enabled": true },
          { "category": "Management", "enabled": true },
          { "category": "Feed", "enabled": true }
        ]
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2023-09-01",
      "name": "[variables('vmName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', variables('nicName'))]"
      ],
      "properties": {
        "hardwareProfile": {
          "vmSize": "[variables('vmSize')]"
        },
        "osProfile": {
          "computerName": "[variables('vmName')]",
          "adminUsername": "[parameters('adminUsername')]",
          "adminPassword": "[parameters('adminPassword')]"
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "MicrosoftWindowsDesktop",
            "offer": "windows-11",
            "sku": "[variables('imageSku')]",
            "version": "latest"
          },
          "osDisk": {
            "createOption": "FromImage",
            "diskSizeGB": "[variables('diskSizeGB')]",
            "managedDisk": {
              "storageAccountType": "[variables('diskStorageType')]"
            }
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('nicName'))]"
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "apiVersion": "2023-09-01",
      "name": "[concat(variables('vmName'), '/AADLoginForWindows')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines', variables('vmName'))]"
      ],
      "properties": {
        "publisher": "Microsoft.Azure.ActiveDirectory",
        "type": "AADLoginForWindows",
        "typeHandlerVersion": "2.0",
        "autoUpgradeMinorVersion": true
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "apiVersion": "2023-09-01",
      "name": "[concat(variables('vmName'), '/OfficeAppsInstall')]",
      "location": "[parameters('location')]",
      "condition": "[equals(parameters('pizzaToppings'), '🌭 Sausage (Windows 11 25H2 Enterprise, newest)')]",
      "comments": "fileUris pinned to a specific commit SHA (not `main`), per data-governance review finding F2 (High) / RAID R-3 mitigation, 2026-08-24 — a future push to `main` can no longer silently change what this script executes. Re-pin to a new SHA deliberately, after re-verifying the script, if it's ever revised.",
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines', variables('vmName'))]"
      ],
      "properties": {
        "publisher": "Microsoft.Compute",
        "type": "CustomScriptExtension",
        "typeHandlerVersion": "1.10",
        "autoUpgradeMinorVersion": true,
        "settings": {
          "fileUris": [
            "https://raw.githubusercontent.com/nickprignano/fresh-desktop-demo/33cffcabf2e2b887ab80d09d1a58c0d75d9142b5/office-apps-install.ps1"
          ],
          "commandToExecute": "powershell.exe -NonInteractive -ExecutionPolicy Bypass -File office-apps-install.ps1"
        }
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "apiVersion": "2023-09-01",
      "name": "[concat(variables('vmName'), '/AVDAgentDSC')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines/extensions', variables('vmName'), 'AADLoginForWindows')]",
        "[resourceId('Microsoft.DesktopVirtualization/hostPools', variables('hostPoolName'))]"
      ],
      "properties": {
        "publisher": "Microsoft.Powershell",
        "type": "DSC",
        "typeHandlerVersion": "2.83",
        "autoUpgradeMinorVersion": true,
        "settings": {
          "modulesUrl": "https://wvdportalstorageblob.blob.core.windows.net/galleryartifacts/Configuration.zip",
          "configurationFunction": "Configuration.ps1\\AddSessionHost",
          "properties": {
            "hostPoolName": "[variables('hostPoolName')]"
          }
        },
        "protectedSettings": {
          "properties": {
            "registrationInfoToken": "[reference(resourceId('Microsoft.DesktopVirtualization/hostPools', variables('hostPoolName'))).registrationInfo.token]"
          }
        }
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "apiVersion": "2023-09-01",
      "name": "[concat(variables('vmName'), '/FreshDesktopBranding')]",
      "location": "[parameters('location')]",
      "comments": "fileUris pinned to a specific commit SHA (not `main`), per data-governance review finding F2 (High) / RAID R-3 mitigation, 2026-08-24 — a future push to `main` can no longer silently change what this script executes. Re-pin to a new SHA deliberately, after re-verifying the script, if it's ever revised.",
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines/extensions', variables('vmName'), 'AVDAgentDSC')]"
      ],
      "properties": {
        "publisher": "Microsoft.Compute",
        "type": "CustomScriptExtension",
        "typeHandlerVersion": "1.10",
        "autoUpgradeMinorVersion": true,
        "settings": {
          "fileUris": [
            "https://raw.githubusercontent.com/nickprignano/fresh-desktop-demo/33cffcabf2e2b887ab80d09d1a58c0d75d9142b5/fresh-desktop-branding.ps1"
          ],
          "commandToExecute": "powershell.exe -NonInteractive -ExecutionPolicy Bypass -File fresh-desktop-branding.ps1"
        }
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.DesktopVirtualization/applicationGroups', variables('appGroupName')), deployer().objectId, variables('desktopVirtualizationUserRoleId'))]",
      "scope": "[resourceId('Microsoft.DesktopVirtualization/applicationGroups', variables('appGroupName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.DesktopVirtualization/applicationGroups', variables('appGroupName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('desktopVirtualizationUserRoleId'))]",
        "principalId": "[deployer().objectId]"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.Compute/virtualMachines', variables('vmName')), deployer().objectId, variables('vmUserLoginRoleId'))]",
      "scope": "[resourceId('Microsoft.Compute/virtualMachines', variables('vmName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines', variables('vmName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('vmUserLoginRoleId'))]",
        "principalId": "[deployer().objectId]"
      }
    }
  ],
  "outputs": {
    "loggedInAs": {
      "type": "string",
      "value": "[deployer().userPrincipalName]"
    },
    "webClientUrl": {
      "type": "string",
      "value": "https://client.wvd.microsoft.com/arm/webclient"
    },
    "hostPoolName": {
      "type": "string",
      "value": "[variables('hostPoolName')]"
    },
    "vmName": {
      "type": "string",
      "value": "[variables('vmName')]"
    },
    "orderSummary": {
      "type": "string",
      "value": "[concat('Order: ', parameters('pizzaSize'), ' | ', parameters('pizzaCrust'), ' | ', parameters('pizzaToppings'), ' | ', parameters('toppingPepperoni'), ' | Order #', variables('orderNumber'), ' | auto-destroys ', variables('selfDestructAtUtc'))]"
    },
    "orderNumber": {
      "type": "string",
      "value": "[variables('orderNumber')]"
    },
    "selfDestructAtUtc": {
      "type": "string",
      "value": "[variables('selfDestructAtUtc')]"
    },
    "logAnalyticsWorkspaceName": {
      "type": "string",
      "value": "[variables('logAnalyticsWorkspaceName')]"
    }
  }
}
