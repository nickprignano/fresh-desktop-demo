{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "One-click demo: deploys a minimal native Azure Virtual Desktop environment (host pool, workspace, desktop application group, one Microsoft Entra-joined session host) and grants the person who deploys it access to log in immediately via the AVD web client. Demo/POC only \u2014 not hardened for production."
  },
  "parameters": {
    "namePrefix": {
      "type": "string",
      "defaultValue": "avddemo",
      "minLength": 3,
      "maxLength": 10,
      "metadata": {
        "description": "Short prefix used to name all resources (lowercase letters/numbers only, e.g. avddemo)."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region to deploy into. Defaults to the resource group's region."
      }
    },
    "pizzaSize": {
      "type": "string",
      "defaultValue": "\ud83c\udf55 Personal Pan (2 vCPU / 8 GB)",
      "allowedValues": [
        "\ud83c\udf55 Personal Pan (2 vCPU / 8 GB)",
        "\ud83c\udf55\ud83c\udf55 Family Size (4 vCPU / 16 GB)",
        "\ud83c\udf55\ud83c\udf55\ud83c\udf55 Large Party (8 vCPU / 32 GB)"
      ],
      "metadata": {
        "description": "Session host VM size. Personal Pan is plenty for a demo."
      }
    },
    "pizzaCrust": {
      "type": "string",
      "defaultValue": "\ud83e\uddc0 Stuffed Crust (Standard SSD disk \u2014 balanced, default)",
      "allowedValues": [
        "\ud83e\uddc0 Stuffed Crust (Standard SSD disk \u2014 balanced, default)",
        "\ud83c\udf5e Thin Crust (Standard HDD disk \u2014 cheapest, slower)",
        "\ud83c\udf55 Deep Dish (Premium SSD disk \u2014 fastest, priciest)"
      ],
      "metadata": {
        "description": "OS disk tier for the session host (Chicago-style naming: Deep Dish is the good one). Doesn't change deploy time \u2014 just cost and in-session disk performance."
      }
    },
    "pizzaToppings": {
      "type": "string",
      "defaultValue": "\ud83e\uddc0 Cheese (Windows 11 24H2, no apps)",
      "allowedValues": [
        "\ud83e\uddc0 Cheese (Windows 11 24H2, no apps)",
        "\ud83c\udf2d Sausage (Windows 11 24H2 + Microsoft 365 Apps)",
        "\ud83c\udf55 Pepperoni (Windows 11 23H2 + Microsoft 365 Apps)"
      ],
      "metadata": {
        "description": "Desktop OS image. Sausage and Pepperoni both take a little longer to boot the first time (Microsoft 365 Apps preinstalled); Pepperoni uses the prior Windows 11 release."
      }
    },
    "toppingExtraCheese": {
      "type": "string",
      "defaultValue": "Yes, extra cheese (higher session capacity)",
      "allowedValues": [
        "Yes, extra cheese (higher session capacity)",
        "No thanks (default capacity)"
      ],
      "metadata": {
        "description": "Raises the host pool's max concurrent session limit. Cosmetic for a 1-VM demo, but real."
      }
    },
    "toppingPepperoni": {
      "type": "string",
      "defaultValue": "Yes, pepperoni (clipboard + drive redirection on)",
      "allowedValues": [
        "Yes, pepperoni (clipboard + drive redirection on)",
        "No thanks (locked down session)"
      ],
      "metadata": {
        "description": "Toggles a real RDP property: local clipboard and drive redirection into the session."
      }
    },
    "adminUsername": {
      "type": "string",
      "defaultValue": "avddemoadmin",
      "metadata": {
        "description": "Local administrator username for the session host (not used for AVD sign-in, which uses Microsoft Entra ID)."
      }
    },
    "adminPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Local administrator password for the session host. Must meet Azure complexity requirements (12+ chars, 3 of: upper/lower/number/symbol)."
      }
    },
    "utcValue": {
      "type": "string",
      "defaultValue": "[utcNow()]"
    }
  },
  "variables": {
    "hostPoolName": "[concat(parameters('namePrefix'), '-hp')]",
    "appGroupName": "[concat(parameters('namePrefix'), '-dag')]",
    "workspaceName": "[concat(parameters('namePrefix'), '-ws')]",
    "vnetName": "[concat(parameters('namePrefix'), '-vnet')]",
    "subnetName": "default",
    "nicName": "[concat(parameters('namePrefix'), '-nic')]",
    "vmName": "[concat(parameters('namePrefix'), '-vm')]",
    "addressPrefix": "10.20.0.0/24",
    "subnetPrefix": "10.20.0.0/24",
    "registrationTokenExpiration": "[dateTimeAdd(parameters('utcValue'), 'PT4H')]",
    "desktopVirtualizationUserRoleId": "1d18fff3-a72a-46b5-b4a9-0b38a3cd7e63",
    "vmUserLoginRoleId": "fb879df8-f326-4884-b1cf-06f3ad86be52",
    "vmSizeMap": {
      "\ud83c\udf55 Personal Pan (2 vCPU / 8 GB)": "Standard_D2as_v5",
      "\ud83c\udf55\ud83c\udf55 Family Size (4 vCPU / 16 GB)": "Standard_D4as_v5",
      "\ud83c\udf55\ud83c\udf55\ud83c\udf55 Large Party (8 vCPU / 32 GB)": "Standard_D8as_v5"
    },
    "imageSkuMap": {
      "\ud83e\uddc0 Cheese (Windows 11 24H2, no apps)": "win11-24h2-avd",
      "\ud83c\udf2d Sausage (Windows 11 24H2 + Microsoft 365 Apps)": "win11-24h2-avd-m365",
      "\ud83c\udf55 Pepperoni (Windows 11 23H2 + Microsoft 365 Apps)": "win11-23h2-avd-m365"
    },
    "sessionLimitMap": {
      "Yes, extra cheese (higher session capacity)": 10,
      "No thanks (default capacity)": 5
    },
    "rdpPropertyMap": {
      "Yes, pepperoni (clipboard + drive redirection on)": "drivestoredirect:s:*;redirectclipboard:i:1;",
      "No thanks (locked down session)": ""
    },
    "diskTierMap": {
      "\ud83e\uddc0 Stuffed Crust (Standard SSD disk \u2014 balanced, default)": {
        "storageType": "StandardSSD_LRS",
        "sizeGB": 128
      },
      "\ud83c\udf5e Thin Crust (Standard HDD disk \u2014 cheapest, slower)": {
        "storageType": "Standard_LRS",
        "sizeGB": 128
      },
      "\ud83c\udf55 Deep Dish (Premium SSD disk \u2014 fastest, priciest)": {
        "storageType": "Premium_LRS",
        "sizeGB": 256
      }
    },
    "vmSize": "[variables('vmSizeMap')[parameters('pizzaSize')]]",
    "imageSku": "[variables('imageSkuMap')[parameters('pizzaToppings')]]",
    "maxSessionLimit": "[variables('sessionLimitMap')[parameters('toppingExtraCheese')]]",
    "customRdpProperty": "[variables('rdpPropertyMap')[parameters('toppingPepperoni')]]",
    "diskStorageType": "[variables('diskTierMap')[parameters('pizzaCrust')].storageType]",
    "diskSizeGB": "[variables('diskTierMap')[parameters('pizzaCrust')].sizeGB]"
  },
  "resources": [
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2023-09-01",
      "name": "[variables('vnetName')]",
      "location": "[parameters('location')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "[variables('addressPrefix')]"
          ]
        },
        "subnets": [
          {
            "name": "[variables('subnetName')]",
            "properties": {
              "addressPrefix": "[variables('subnetPrefix')]"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2023-09-01",
      "name": "[variables('nicName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
      ],
      "properties": {
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "subnet": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), variables('subnetName'))]"
              }
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.DesktopVirtualization/hostPools",
      "apiVersion": "2024-04-03",
      "name": "[variables('hostPoolName')]",
      "location": "[parameters('location')]",
      "properties": {
        "hostPoolType": "Pooled",
        "loadBalancerType": "BreadthFirst",
        "preferredAppGroupType": "Desktop",
        "maxSessionLimit": "[variables('maxSessionLimit')]",
        "customRdpProperty": "[variables('customRdpProperty')]",
        "startVMOnConnect": true,
        "validationEnvironment": false,
        "registrationInfo": {
          "expirationTime": "[variables('registrationTokenExpiration')]",
          "registrationTokenOperation": "Update"
        }
      }
    },
    {
      "type": "Microsoft.DesktopVirtualization/applicationGroups",
      "apiVersion": "2024-04-03",
      "name": "[variables('appGroupName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.DesktopVirtualization/hostPools', variables('hostPoolName'))]"
      ],
      "properties": {
        "applicationGroupType": "Desktop",
        "hostPoolArmPath": "[resourceId('Microsoft.DesktopVirtualization/hostPools', variables('hostPoolName'))]"
      }
    },
    {
      "type": "Microsoft.DesktopVirtualization/workspaces",
      "apiVersion": "2024-04-03",
      "name": "[variables('workspaceName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.DesktopVirtualization/applicationGroups', variables('appGroupName'))]"
      ],
      "properties": {
        "friendlyName": "AVD Demo Workspace",
        "applicationGroupReferences": [
          "[resourceId('Microsoft.DesktopVirtualization/applicationGroups', variables('appGroupName'))]"
        ]
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2023-09-01",
      "name": "[variables('vmName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', variables('nicName'))]"
      ],
      "properties": {
        "hardwareProfile": {
          "vmSize": "[variables('vmSize')]"
        },
        "osProfile": {
          "computerName": "[variables('vmName')]",
          "adminUsername": "[parameters('adminUsername')]",
          "adminPassword": "[parameters('adminPassword')]"
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "MicrosoftWindowsDesktop",
            "offer": "windows-11",
            "sku": "[variables('imageSku')]",
            "version": "latest"
          },
          "osDisk": {
            "createOption": "FromImage",
            "diskSizeGB": "[variables('diskSizeGB')]",
            "managedDisk": {
              "storageAccountType": "[variables('diskStorageType')]"
            }
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('nicName'))]"
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "apiVersion": "2023-09-01",
      "name": "[concat(variables('vmName'), '/AADLoginForWindows')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines', variables('vmName'))]"
      ],
      "properties": {
        "publisher": "Microsoft.Azure.ActiveDirectory",
        "type": "AADLoginForWindows",
        "typeHandlerVersion": "2.0",
        "autoUpgradeMinorVersion": true
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "apiVersion": "2023-09-01",
      "name": "[concat(variables('vmName'), '/AVDAgentDSC')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines/extensions', variables('vmName'), 'AADLoginForWindows')]",
        "[resourceId('Microsoft.DesktopVirtualization/hostPools', variables('hostPoolName'))]"
      ],
      "properties": {
        "publisher": "Microsoft.Powershell",
        "type": "DSC",
        "typeHandlerVersion": "2.83",
        "autoUpgradeMinorVersion": true,
        "settings": {
          "modulesUrl": "https://wvdportalstorageblob.blob.core.windows.net/galleryartifacts/Configuration.zip",
          "configurationFunction": "Configuration.ps1\\AddSessionHost",
          "properties": {
            "hostPoolName": "[variables('hostPoolName')]",
            "aadJoin": true
          }
        },
        "protectedSettings": {
          "properties": {
            "registrationInfoToken": "[reference(resourceId('Microsoft.DesktopVirtualization/hostPools', variables('hostPoolName'))).registrationInfo.token]"
          }
        }
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "apiVersion": "2023-09-01",
      "name": "[concat(variables('vmName'), '/FreshDesktopBranding')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines/extensions', variables('vmName'), 'AVDAgentDSC')]"
      ],
      "properties": {
        "publisher": "Microsoft.Compute",
        "type": "CustomScriptExtension",
        "typeHandlerVersion": "1.10",
        "autoUpgradeMinorVersion": true,
        "settings": {
          "fileUris": [
            "https://raw.githubusercontent.com/nickprignano/fresh-desktop-demo/main/fresh-desktop-branding.ps1"
          ],
          "commandToExecute": "powershell.exe -NonInteractive -ExecutionPolicy Bypass -File fresh-desktop-branding.ps1"
        }
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.DesktopVirtualization/applicationGroups', variables('appGroupName')), deployer().objectId, variables('desktopVirtualizationUserRoleId'))]",
      "scope": "[resourceId('Microsoft.DesktopVirtualization/applicationGroups', variables('appGroupName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.DesktopVirtualization/applicationGroups', variables('appGroupName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('desktopVirtualizationUserRoleId'))]",
        "principalId": "[deployer().objectId]"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.Compute/virtualMachines', variables('vmName')), deployer().objectId, variables('vmUserLoginRoleId'))]",
      "scope": "[resourceId('Microsoft.Compute/virtualMachines', variables('vmName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines', variables('vmName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('vmUserLoginRoleId'))]",
        "principalId": "[deployer().objectId]"
      }
    }
  ],
  "outputs": {
    "loggedInAs": {
      "type": "string",
      "value": "[deployer().userPrincipalName]"
    },
    "webClientUrl": {
      "type": "string",
      "value": "https://client.wvd.microsoft.com/arm/webclient"
    },
    "hostPoolName": {
      "type": "string",
      "value": "[variables('hostPoolName')]"
    },
    "vmName": {
      "type": "string",
      "value": "[variables('vmName')]"
    },
    "orderSummary": {
      "type": "string",
      "value": "[concat('Order: ', parameters('pizzaSize'), ' | ', parameters('pizzaCrust'), ' | ', parameters('pizzaToppings'), ' | ', parameters('toppingExtraCheese'), ' | ', parameters('toppingPepperoni'))]"
    }
  }
}
